# Copy to .env and adjust. Never commit .env.
# Values for DATABASE_URL / REDIS_URL / DATA_DIR are set by docker-compose for containers;
# the ones below are for running tools on the host.

CLIPFORGE_ENV=dev
CLIPFORGE_LOG_LEVEL=INFO
CLIPFORGE_LOG_JSON=true

CLIPFORGE_DATABASE_URL=postgresql+psycopg://clipforge:clipforge@localhost:5432/clipforge
CLIPFORGE_REDIS_URL=redis://localhost:6379/0
CLIPFORGE_DATA_DIR=./data

# Compute: auto | cuda | cpu
CLIPFORGE_DEVICE=auto
CLIPFORGE_ASR_MODEL=large-v3
CLIPFORGE_ASR_COMPUTE_TYPE=int8_float16

# Highlight analysis backend (ADR-0005): claude_code | ollama | anthropic_api
CLIPFORGE_LLM_BACKEND=claude_code
CLIPFORGE_OLLAMA_URL=http://host.docker.internal:11434
CLIPFORGE_OLLAMA_MODEL=qwen3:8b
# Paid API stays off unless you explicitly enable it.
CLIPFORGE_ANTHROPIC_API_ENABLED=false
CLIPFORGE_ANTHROPIC_API_KEY=

# Hugging Face token (needed for pyannote in Phase 3; accept the model terms on HF first)
CLIPFORGE_HF_TOKEN=

# Change for anything other than local dev
CLIPFORGE_SECRET_KEY=change-me

# Host port for reaching the stack's Postgres from Windows (5432 is often taken by a local install)
POSTGRES_HOST_PORT=5433

# Claude Code via the host bridge (run: python backend/scripts/llm_bridge.py). No API key, no per-token billing.
CLIPFORGE_LLM_BRIDGE_TOKEN=generate-a-long-random-string
CLIPFORGE_LLM_DISCOVER_MODEL=sonnet
CLIPFORGE_LLM_REFINE_MODEL=sonnet
